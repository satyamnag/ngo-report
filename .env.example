# ---------- Object storage ----------
# "local" = filesystem (dev, zero dependencies) | "minio" = S3-compatible
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=data/storage
# MINIO_ENDPOINT=minio:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_SECURE=false
# MINIO_BUCKET=ngo-report

# ---------- Database (PostgreSQL 16) ----------
DATABASE_URL=postgresql+psycopg://ngo_app:ngo_app_dev_password@localhost:5432/ngo_report

# ---------- Redis / Celery ----------
REDIS_URL=redis://localhost:6379/0
# Set to true to run generation synchronously (no worker) for tests/demo
CELERY_TASK_EAGER=false

# ---------- Auth (SECRETS: override in production) ----------
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- App ----------
FRONTEND_ORIGIN=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:8000
TEMPLATE_ASSETS_DIR=templates
MAX_UPLOAD_BYTES=10485760

# ---------- Frontend ----------
# The frontend calls the API same-origin (/api/* -> proxied by next.config rewrites).
# Set BACKEND_URL at build time to point the proxy at your FastAPI backend.
BACKEND_URL=http://35.200.149.48